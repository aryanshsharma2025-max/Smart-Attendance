# ===================================================================
# SMART ATTENDANCE MANAGEMENT SYSTEM — ENVIRONMENT VARIABLES
# SSIPMT Raipur · CSE Department · 3rd Semester · July–Dec 2026
# Canonical Backend: Spring Boot 3.3.3 + MySQL 8.0 + Spring Security + JWT
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3306/attendance_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration (HMAC-SHA256, minimum 256-bit key)
# DO NOT USE IN PRODUCTION: Replace with a cryptographically secure random 256-bit key
JWT_SECRET=your_secure_256_bit_jwt_secret_key_placeholder_ssipmt_raipur_dev
JWT_EXPIRATION_MS=86400000

# Spring Application Profile
SPRING_PROFILES_ACTIVE=prod
